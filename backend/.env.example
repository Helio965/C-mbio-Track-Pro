# Modelo de configuração. Copie para backend/.env e preencha. Nunca envie o .env ao Git ou ao ZIP.
# Preencha com uma chave própria. Gere com node -p "require('node:crypto').randomBytes(32).toString('hex')"
JWT_SECRET=
PORT=3000
# Caminho relativo à pasta de execução do servidor ou caminho absoluto.
DB_PATH=./data/cambio.sqlite
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcional. Chave gratuita da AwesomeAPI (awesomeapi.com.br), útil se a fonte responder HTTP 429.
AWESOMEAPI_KEY=
