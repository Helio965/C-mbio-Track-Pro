{
  "name": "cambio-track-pro-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API de simulações de câmbio do Projeto 02",
  "type": "commonjs",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start:proxy": "node --use-env-proxy --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
